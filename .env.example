# 复制本文件为 .env 再填入真实值：  Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，永远不要提交；本文件只放占位符，可以提交。

# --- L01 起：DeepSeek API（platform.deepseek.com -> API Keys）---
DEEPSEEK_API_KEY=

# --- L05 起：SEC EDGAR 要求 User-Agent 带真实联系方式，否则返回 403 ---
SEC_USER_AGENT="FinAgent-learning your_email@example.com"

# --- L08 起（可选）：把 Hugging Face 模型缓存放到空间大的盘 ---
# HF_HOME=D:/hf_cache
